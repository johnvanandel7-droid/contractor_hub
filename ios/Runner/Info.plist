<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Contractor Hub</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>contractor_hub</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Contacts: boss-only phone contact sync (flutter_contacts). -->
	<key>NSContactsUsageDescription</key>
	<string>Contractor Hub reads your contacts so a company owner can import them into the shared company contact list.</string>

	<!-- Location: clock in/out geofencing and jobsite creation (geolocator). -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Contractor Hub uses your location to clock you in and out at job sites and to record job site boundaries.</string>
	<!-- Used by Geolocator.requestTemporaryFullAccuracy(purposeKey: 'JobSiteGeofencing')
	     in your_jobs_screen.dart. The key below must match that purposeKey exactly. -->
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>JobSiteGeofencing</key>
		<string>Precise location is needed to set an accurate boundary around a job site.</string>
	</dict>

	<!-- Photos: image_picker for construction images and PO logs. -->
	<key>NSCameraUsageDescription</key>
	<string>Contractor Hub uses the camera to attach photos to jobs and purchase orders.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Contractor Hub accesses your photo library to attach pictures to jobs and purchase orders.</string>
</dict>
</plist>